{
  "name": "zbynekstara-npm-test",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dist": "yarn workspaces foreach --all -tvv run dist",
    "test": "yarn workspaces foreach --all -tvv run test",
    "lint": "yarn workspaces foreach --all -tvv run lint",
    "pack-all": "yarn workspaces foreach --all -tvv --include \"@zbynekstara-test/core\" --include \"@zbynekstara-test/dep\" pack --out %s-%v.tgz"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.0"
  },
  "workspaces": [
    "./packages/*"
  ],
  "volta": {
    "node": "22.14.0",
    "yarn": "4.18.0"
  },
  "packageManager": "yarn@4.18.0"
}
